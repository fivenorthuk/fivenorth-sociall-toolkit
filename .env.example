# Client access tokens as a JSON object mapping client slug -> token.
# When set, this OVERRIDES clients.json. Recommended for production so tokens
# are not committed to source control.
#
# Set it in the Netlify UI (Site settings -> Environment variables) or locally
# by copying this file to .env (netlify dev loads it automatically).
CLIENT_TOKENS={"crowther-key":"abc-123","acme-co":"xyz-789"}
