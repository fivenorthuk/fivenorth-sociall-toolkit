# Copy to .env for local dev (loaded by `netlify dev`; .env is git-ignored).

# REQUIRED: signs the login session cookies. Use a long random string.
#   openssl rand -hex 32
SESSION_SECRET=please-change-me-to-a-long-random-string

# OPTIONAL: overrides clients.json so client names/passwords stay out of git.
# Same shape as clients.json, as a single line of JSON:
# CLIENT_TOKENS={"crowther-key":{"name":"Crowther Key","password":"abc-123"}}
